{
  "name": "@keystone/desktop",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Thin desktop shell: a supervised loopback Run Protocol runtime behind a same-origin proxy, with a native macOS WKWebView window and first-run BYOK onboarding",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "keystone-desktop": "./src/bin.ts"
  },
  "scripts": {
    "desktop:build-window": "swiftc src-native/KeystoneWindow.swift -o bin/keystone-window -framework Cocoa -framework WebKit -O"
  },
  "dependencies": {
    "@keystone/kernel": "workspace:*",
    "@keystone/models": "workspace:*"
  }
}
